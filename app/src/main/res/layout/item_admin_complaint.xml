<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="8dp"
    android:paddingHorizontal="10dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tvStudentName"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="Student Name"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvComplaintId"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="CMP001"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvCategory"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="Hostel"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvDate"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="01/01/2024"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="Pending"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnPending"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Pending"
            android:textSize="9sp"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_pending_selector"
            android:backgroundTint="@null"
            android:layout_marginEnd="2dp"
            android:padding="0dp"/>

        <Button
            android:id="@+id/btnProcessing"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Processing"
            android:textSize="9sp"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_processing_selector"
            android:backgroundTint="@null"
            android:layout_marginEnd="2dp"
            android:padding="0dp"/>

        <Button
            android:id="@+id/btnResolve"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Resolve"
            android:textSize="9sp"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_resolved_selector"
            android:backgroundTint="@null"
            android:layout_marginEnd="4dp"
            android:padding="0dp"/>

        <ImageView
            android:id="@+id/btnDetails"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_info_details"
            android:padding="2dp"
            android:contentDescription="Details"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:tint="?attr/colorPrimary" />

    </LinearLayout>

</LinearLayout>