<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <FrameLayout
        android:id="@+id/logoFrame"
        android:layout_width="350dp"
        android:layout_height="350dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 1. Spinning Layer: The full logo that rotates -->
        <ImageView
            android:id="@+id/logo_outer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@raw/logo"
            android:scaleType="fitCenter"
            android:contentDescription="Spinning Logo" />

        <!-- 2. Fixed Center Window: A stationary circular clip -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/logo_center_window"
            android:layout_width="186dp"
            android:layout_height="186dp"
            android:layout_gravity="center"
            app:cardCornerRadius="93dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?android:attr/windowBackground"
            app:cardPreventCornerOverlap="false"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="350dp"
                android:layout_height="350dp"
                android:layout_gravity="center"
                android:src="@raw/logo"
                android:scaleType="fitCenter"
                android:contentDescription="Fixed Logo Center" />

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

    <TextView
        android:id="@+id/appName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="SMARTIFY"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="40sp"
        android:textStyle="bold"
        android:letterSpacing="0.2"
        app:layout_constraintTop_toBottomOf="@id/logoFrame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>