<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <FrameLayout
        android:id="@+id/logoFrame"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <!-- 1. The Turbine Ring (Rotates) -->
        <ImageView
            android:id="@+id/logo_outer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@raw/logo" />

        <!-- 2. The Fixed Center Building (Stationary) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/logo_center_window"
            android:layout_width="172dp"
            android:layout_height="172dp"
            android:layout_gravity="center"
            app:cardBackgroundColor="#000000"
            app:cardCornerRadius="86dp"
            app:cardElevation="0dp"
            app:cardPreventCornerOverlap="false"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="320dp"
                android:layout_height="320dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@raw/logo" />

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

    <TextView
        android:id="@+id/appName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="SMARTIFY"
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        android:textStyle="bold"
        android:letterSpacing="0.2"
        android:alpha="0"
        app:layout_constraintTop_toBottomOf="@id/logoFrame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>