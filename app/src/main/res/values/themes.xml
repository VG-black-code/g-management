<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base theme -->
    <style name="Base.Theme.Demoapp" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="colorSurface">@color/card_bg_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
        <item name="colorSurfaceVariant">#F5F5F5</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_light</item>
        <item name="android:textColorPrimary">@color/text_primary_light</item>
        <item name="android:textColorSecondary">@color/text_secondary_light</item>
        <item name="android:colorControlHighlight">#20000000</item>
    </style>

    <!-- Default Theme (Blue) -->
    <style name="Theme.Demoapp" parent="Base.Theme.Demoapp" />

    <!-- Orange Theme -->
    <style name="Theme.Demoapp.Orange" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/orange_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/orange_bg</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
        <item name="colorSurfaceVariant">#FFF3E0</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_light</item>
        <item name="android:textColorPrimary">@color/text_primary_light</item>
        <item name="android:textColorSecondary">@color/text_secondary_light</item>
    </style>

    <!-- Dark Theme -->
    <style name="Theme.Demoapp.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/blue_primary_dark</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/card_bg_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="colorSurfaceVariant">#2C2C2C</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_dark</item>
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
    </style>

    <!-- Lavender Theme -->
    <style name="Theme.Demoapp.Lavender" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/lavender_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/lavender_bg</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
        <item name="colorSurfaceVariant">#F3E5F5</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_light</item>
        <item name="android:textColorPrimary">@color/text_primary_light</item>
        <item name="android:textColorSecondary">@color/text_secondary_light</item>
    </style>

    <!-- Light Blue Theme -->
    <style name="Theme.Demoapp.LightBlue" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/lightblue_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/lightblue_bg</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
        <item name="colorSurfaceVariant">#E1F5FE</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_light</item>
        <item name="android:textColorPrimary">@color/text_primary_light</item>
        <item name="android:textColorSecondary">@color/text_secondary_light</item>
    </style>

    <style name="Theme.FullScreen" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="CircleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>